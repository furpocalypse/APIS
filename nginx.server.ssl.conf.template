# NGINX_SSL_MODE=on
#
# nginx terminates TLS itself. Use this when there is no upstream TLS
# terminator (e.g. Cloudflare with "Full (strict)" origin verification,
# bare-metal exposure, or single-VM topologies without AppGW/Front Door).
#
# Rendered at container boot by start.sh — envsubst expands these tokens
# (nginx's own $variables pass through unchanged):
#
#   ${NGINX_SERVER_NAMES}
#       Whitespace-separated list of hostnames to accept on port 443. The
#       cert at /app/ssl/fullchain.pem must cover every name in the list.
#       Falls back to "_" (catch-all) if unset, which only works if the
#       cert is a wildcard or covers a single name and you don't care
#       about strict SNI matching.
#
# Cert paths are hardcoded to /app/ssl/{fullchain,privkey}.pem. The host
# bind-mounts a directory of those files into the container as read-only.
# start.sh refuses to start in this mode if either file is missing.

# --- HTTP -> HTTPS redirect ----------------------------------------------
# Lets Encrypt and most certificate-issuing flows still need port 80 open
# for ACME http-01 challenges; if you're using one, add a `location
# /.well-known/acme-challenge/` block in front of the redirect.
server {
    listen 80 default_server;
    server_name ${NGINX_SERVER_NAMES};

    # When TRUSTED_PROXY_MODE=proxy with FRONT_DOOR_ID set, $trusted_origin
    # is "0" for any request that didn't come from the trusted edge.
    if ($trusted_origin = "0") { return 403; }

    return 301 https://$host$request_uri;
}

# --- HTTPS terminator ----------------------------------------------------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${NGINX_SERVER_NAMES};

    if ($trusted_origin = "0") { return 403; }

    ssl_certificate     /app/ssl/fullchain.pem;
    ssl_certificate_key /app/ssl/privkey.pem;

    # OWASP Transport Layer Protection cheat sheet: TLS 1.2+ only, prefer
    # AEAD ciphers, server-chosen ordering. Avoid CBC modes where possible.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # OCSP stapling — saves the client a round-trip to the CA.
    ssl_stapling        on;
    ssl_stapling_verify on;
    resolver            1.1.1.1 1.0.0.1 valid=300s;
    resolver_timeout    5s;

    # HSTS is also set by Django (SECURE_HSTS_SECONDS) but adding it here
    # keeps the header on /static/ responses, which Django doesn't serve.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $http_host;

        proxy_set_header Forwarded          "";
        proxy_set_header X-Real-Ip-Original "";

        proxy_pass http://unix:/tmp/apis.sock;
    }

    location /static/ {
        alias /app/apis/static/;
        add_header "Cache-Control" "max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}
