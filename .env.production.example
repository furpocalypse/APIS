# --------------------------------------------------------------------------
# APIS — Azure production .env template.
#
# Copy to `.env` on the Azure VM and fill in the marked values.  This file
# is checked in as a template; the real `.env` lives only on the VM and
# is *.env*-ignored by git + .dockerignore.
#
# RULE: anything tagged [REQUIRED] is a deploy-blocker — settings.py
# raises RuntimeError if it's unset or contains a placeholder.
# Anything tagged [SECRET] must come from Azure Key Vault (Managed Identity
# binding at boot), not from this file in plain text.
# --------------------------------------------------------------------------

# === Django core ==========================================================

# [REQUIRED] Decision #11: the canonical single settings module + the
# positive production signal. APIS_ENV=production arms the fail-closed
# guards in settings.py (no DEBUG, no E2E_MODE, non-empty trusted IP
# header). The process manager loads THIS file (compose env_file: /
# systemd EnvironmentFile=) as .env.production (gitignored; distributed
# out-of-band — copy this template, fill the [REQUIRED]/[SECRET] values).
APIS_ENV=production
DJANGO_SETTINGS_MODULE=fm_eventmanager.settings

# [REQUIRED] [SECRET] Cryptographic root for sessions, CSRF, signing.
# Generate ONCE per deployment with:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
# Rotation invalidates all existing sessions; plan accordingly.
DJANGO_SECRET_KEY=

# Production: MUST be False. settings.py refuses to start with
# debug on for any non-localhost ALLOWED_HOSTS.
DJANGO_DEBUG=False

DJANGO_LOGLEVEL=info

# [REQUIRED] Comma-separated FQDNs Django will serve. NO wildcards in prod
# (settings.py rejects `*`). Every name in NGINX_SERVER_NAMES (in
# docker-compose.prod.yaml) MUST appear here, OR Django will respond 400
# DisallowedHost to every real visitor. The www. variant matters because
# Cloudflare proxies it through too.
ALLOWED_HOSTS=registration.furpocalypse.org,www.registration.furpocalypse.org

# [REQUIRED] Comma-separated https:// origins allowed to POST. No
# wildcards. Must cover the same hostnames as ALLOWED_HOSTS above.
CSRF_TRUSTED_ORIGINS=https://registration.furpocalypse.org,https://www.registration.furpocalypse.org

TZ=America/New_York

# === Trusted-proxy / client-IP plumbing ===================================
# nginx (in-container) sits behind an Azure trust boundary that terminates
# TLS and supplies real-client headers. See nginx.conf, start.sh,
# fm_eventmanager/settings.py.

# Either "none" (nginx is the edge) or "proxy" (an upstream proxy is in
# front of us). For Azure: almost always "proxy".
TRUSTED_PROXY_MODE=proxy

# [REQUIRED when TRUSTED_PROXY_MODE=proxy]
# Comma-separated CIDR list of the trusted upstream proxy's egress IPs.
# DO NOT use 0.0.0.0/0 here (that's only for the local test stack; it
# enables IP spoofing through forged X-Forwarded-For). Concrete values
# per topology:
#   - Behind Azure Application Gateway:    AppGW subnet CIDR
#     e.g. TRUSTED_PROXY_CIDRS=10.10.0.0/24
#   - Behind Azure Front Door (direct):    egress IPs from the
#     `AzureFrontDoor.Backend` service tag. Refresh monthly from
#     https://www.microsoft.com/download/details.aspx?id=56519
#   - Front Door → AppGW → VMSS:           union of both CIDR sets,
#     plus REAL_IP_RECURSIVE=on (default)
TRUSTED_PROXY_CIDRS=

# Header the trusted edge writes the real client IP to.
#   - AppGW / generic L7 proxies:  X-Forwarded-For (default)
#   - Azure Front Door (direct):   X-Azure-ClientIP
CLIENT_IP_HEADER=X-Forwarded-For

# Walk X-Forwarded-For right-to-left through trusted hops. Default on.
REAL_IP_RECURSIVE=on

# Front Door origin lock-down. When set, nginx returns 403 to any request
# not carrying this exact X-Azure-FDID header — closes the "attacker hits
# origin IP directly to bypass FD's WAF" path. Find the value at:
#   Azure Portal → Front Door → Overview → Front Door ID
# Leave UNSET when not behind Front Door.
#FRONT_DOOR_ID=

# Header that allauth / registration.views.common.get_client_ip read for
# IP resolution. The apis-nginx sidecar writes X-Real-IP from the
# rewritten $remote_addr — leave this default.
TRUSTED_CLIENT_IP_HEADER=X-Real-IP

# === apis-nginx sidecar (TLS termination) ================================
# In the docker-compose topology, a separate apis-nginx container fronts
# this app. Its config is in nginx/ and its env vars (TRUSTED_PROXY_MODE,
# NGINX_SERVER_NAMES, etc.) are set in docker-compose.prod.yaml — NOT
# here. The cert files /opt/apis/certs/{fullchain,privkey}.pem must
# exist on the VM before `docker compose up`.
#
# In AKS we DON'T deploy apis-nginx; AGIC terminates TLS at the gateway.

# === HSTS / TLS ===========================================================
# 1 year, includeSubDomains. Preload is a one-way commitment (you cannot
# un-preload once submitted) — only enable after the domain serves HTTPS
# end-to-end and you have organisational sign-off.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# === Database =============================================================
# Defaults match the in-compose `postgres` service. Switch to managed
# (Azure Database for PostgreSQL Flexible Server) by changing HOST to the
# fully-qualified server name and setting DATABASE_SSLMODE=require (or
# verify-full once the CA bundle is mounted).
DATABASE_HOST=postgres
DATABASE_NAME=apis
DATABASE_USER=apis
# [SECRET] Set in database.env too; the two must match.
DATABASE_PASS=
#DATABASE_PORT=5432
# 'require' for managed Postgres, 'prefer' for in-VM postgres (no TLS).
DATABASE_SSLMODE=prefer

# === Cache / Celery =======================================================
# Defaults match the in-compose `redis` service. For Azure Cache for Redis
# use rediss://<host>:6380/?ssl=true (TLS) and a primary access key.
DJANGO_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2
IDEMPOTENCY_KEY_LOCK_LOCATION=redis://redis:6379

# === Persistent data dir (bind mount target) ==============================
# Where postgres + redis state lives on the VM. MUST be on a persistent
# Azure managed disk for production durability. Compose binds:
#   ${APIS_DATA_DIR}/postgres → /var/lib/postgresql/data
#   ${APIS_DATA_DIR}/redis    → /data
# Pre-create both with `mkdir -p` and `chown 999:999` (the image users).
APIS_DATA_DIR=/srv/apis

# === Email ================================================================
# [REQUIRED if outbound email is in scope] SMTP relay.  Default backend is
# django.core.mail.backends.smtp.EmailBackend.  For dev/staging override:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
APIS_DEFAULT_EMAIL=registration@example.org
DJANGO_SERVER_EMAIL=no-reply@example.org
DEFAULT_FROM_EMAIL=no-reply@example.org

# === Payments — Square ====================================================
# [SECRET] Production keys. Sandbox is OK for staging; flip to real keys
# only after the deploy has been tested end-to-end against sandbox.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_CURRENCY=USD
SQUARE_ENVIRONMENT=production  # or "sandbox"
SQUARE_WEBHOOK_SIGNATURE_KEY=

# === Payments — PayPal ====================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_ENVIRONMENT=production  # or "sandbox"
PAYPAL_WEBHOOK_ID=

# === MQTT (cash-drawer / receipt push) ===================================
# Only needed if the on-site terminal printing fleet is in scope.
MQTT_EXTERNAL_BROKER=wss://mqtt.example.com/mqtt
# [SECRET] base64-encoded HMAC secret
MQTT_JWT_SECRET=
MQTT_BROKER_HOST=mqtt.example.com
MQTT_BROKER_PORT=8883
MQTT_BROKER_TLS=True

# === Gotenberg (PDF rendering, optional service) ==========================
# Only set when running with `--profile gotenberg`. Otherwise leave unset.
#GOTENBERG_HOST=http://gotenberg:3000

# === Sentry (optional, recommended) =======================================
SENTRY_ENABLED=False
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=apis-0.3.1
SENTRY_TRACES_SAMPLE_RATE=0.01
# Keep PII off the wire to Sentry. CLAUDE.md and ASVS V7.1.1 require False.
SENTRY_SEND_DEFAULT_PII=False

# === Admin environment banner (Django admin top bar) =====================
ENVIRONMENT_NAME=Production
ENVIRONMENT_COLOR=#cc0000
ENVIRONMENT_TEXT_COLOR=#ffffff
ENVIRONMENT_FLOAT=True

# === Metrics backend (cron_metrics command) ==============================
# One of: DummyReporter, InfluxDBReporter (legacy v1), InfluxDBv3Reporter
# (current). Must match a registered class in
# registration/management/commands/cron_metrics.py (registry-based lookup;
# arbitrary eval() of this value was removed).
#
# When the monitoring stack overlay is active, set this to
# InfluxDBv3Reporter and fill in the InfluxDB section below.
APIS_METRICS_BACKEND=DummyReporter

# === Monitoring stack (only when docker-compose.monitoring.yaml is in use)
# Activates InfluxDB 3 + Prometheus + node-exporter + Grafana. See
# setup-monitoring.sh for the provisioning files and the operator's
# first-boot bootstrap sequence (create operator token, create the
# `apis` database with 1-year retention).
#
# --- InfluxDB 3 ----------------------------------------------------------
# Endpoint Grafana + cron_metrics + the writer reach InfluxDB over. The
# port (8181) is NOT mapped to the host — only services on the
# docker-network can talk to it. Don't map it to the host.
INFLUXDB_URL=http://influxdb:8181
INFLUXDB_DATABASE=apis
# [SECRET] Operator/admin token, generated AFTER first-boot via:
#   docker compose exec influxdb influxdb3 create token --admin
# The token output is shown ONCE; capture and paste it here, then restart
# grafana (so the provisioned datasource picks it up). Rotate to a
# write-only token via the InfluxDB UI before going to real production.
INFLUXDB_TOKEN=
#
# --- Prometheus + django-prometheus -------------------------------------
# Changes from the default 127.0.0.1: when running with the monitoring
# overlay, Prometheus (in the docker network) needs to scrape django-
# prometheus at app:81. The metrics endpoint is still not host-exposed
# because we don't map port 81 in the compose file; only the docker
# network reaches it.
PROMETHEUS_METRICS_EXPORT_ADDRESS=0.0.0.0
#
# --- Grafana ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# [SECRET] Set this; rotate via the Grafana UI after first login. Anonymous
# access is OFF and account self-signup is disabled.
GRAFANA_ADMIN_PASSWORD=
# Where Grafana publishes itself for self-links (notification links etc.).
# Use the VM's private IP or VNET-internal DNS name.
GRAFANA_ROOT_URL=http://<vm-private-ip>:3000
# Network binding for the host-side Grafana port. Default 0.0.0.0 means
# the VM's NSG must restrict tcp/3000 to the VNET CIDR for the
# "VNET-private" guarantee. Set to 127.0.0.1 for localhost-only + SSH
# tunnel access instead.
GRAFANA_BIND=0.0.0.0
# Set to true only when Grafana is reachable over HTTPS (behind App
# Gateway or with TLS termination configured in front of it).
GRAFANA_COOKIE_SECURE=false
GRAFANA_HSTS=false

# === Optional CSP reporting endpoint ======================================
# When set, browsers POST CSP violation reports here. Sentry exposes a
# CSP-compatible endpoint at /api/<id>/security/?sentry_key=<key>.
#CSP_REPORT_URI=

# === First-run admin bootstrap ===========================================
# Used by `manage.py bootstrap_admin --from-env` to create the initial
# Django superuser non-interactively. Remove BOOTSTRAP_ADMIN_PASSWORD
# from your secret store after first deploy — the command scrubs it from
# os.environ after read but you don't want it persisted.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# [SECRET] Strong password — AUTH_PASSWORD_VALIDATORS will reject weak
# values (>= 12 chars, not common, not similar to username/email).
BOOTSTRAP_ADMIN_PASSWORD=
