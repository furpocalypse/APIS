# .env.dev — local docker-compose dev posture (Decision #11). TRACKED,
# secret-free dev placeholders, fully independent. Loaded via compose
# `env_file:`. Never holds real secrets (those are .env.production, which
# is gitignored and distributed out-of-band).
APIS_ENV=dev
DJANGO_SETTINGS_MODULE=fm_eventmanager.settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-do-not-use-anywhere-real-1234567890abcdef
DJANGO_LOGLEVEL=info
DJANGO_SERVER_EMAIL=no-reply@localhost
APIS_ADMIN_NAME=Local Admin
APIS_ADMIN_EMAIL=admin@localhost
APIS_DEFAULT_EMAIL=registration@localhost
TZ=America/New_York
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUSTED_PROXY_MODE=none
TRUSTED_CLIENT_IP_HEADER=
WHITENOISE_ENABLED=True
CELERY_TASK_ALWAYS_EAGER=False
AXES_ENABLED=True
MQTT_JWT_SECRET=ZGV2LW9ubHktbXF0dC1qd3QtaHMyNTYta2V5LWxvY2Fs
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=apis
DATABASE_USER=apis
DATABASE_PASS=secret
DATABASE_SSLMODE=prefer
DJANGO_DATABASE_POOL=False
DJANGO_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2
IDEMPOTENCY_KEY_LOCK_LOCATION=redis://redis:6379
APIS_DATA_DIR=/srv/apis
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=sandbox-sq0idp-test
SQUARE_ACCESS_TOKEN=test-access-token
SQUARE_LOCATION_ID=test-location
SQUARE_CURRENCY=USD
SQUARE_WEBHOOK_SIGNATURE_KEY=test-key
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=test
PAYPAL_CLIENT_SECRET=test
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=noreply@localhost
EMAIL_HOST_PASSWORD=test
GOTENBERG_HOST=http://gotenberg:3000
