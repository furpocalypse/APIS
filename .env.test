# .env.test — unit-test posture (Decision #11). TRACKED, secret-free,
# fully independent (no inheritance from any other .env.*). Loaded by the
# Makefile TEST_ENV target for `make test`. settings.py owns the logic;
# this file carries only values.
APIS_ENV=test
DJANGO_SETTINGS_MODULE=fm_eventmanager.settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=test
DJANGO_LOGLEVEL=info
ALLOWED_HOSTS=testserver,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://testserver,http://localhost,http://127.0.0.1
# Empty -> allauth get_client_ip falls back to REMOTE_ADDR (127.0.0.1);
# the non-empty-header invariant is APIS_ENV=production-gated only.
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_MODE=none
# Test-runner postures (LOGIC in settings.py keys off these VALUES):
WHITENOISE_ENABLED=False
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True
# Unit suite: axes OFF so the request-less Django test-client login()
# works (real lockout proven by an @override_settings(AXES_ENABLED=True)
# test against /accounts/login/).
AXES_ENABLED=False
# get_token() needs valid base64; deterministic test-only HS256 key.
MQTT_JWT_SECRET=YXBpcy10ZXN0LW9ubHktbXF0dC1qd3QtaHMyNTYta2V5
# Static webhook fixtures embed 2022-2025 timestamps; widen the past
# bound (the freezegun TestWebhookAgeWindow exercises the real bound).
WEBHOOK_MAX_AGE_SECONDS=3153600000
WEBHOOK_FUTURE_SKEW_SECONDS=300
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=test
SQUARE_ACCESS_TOKEN=test
SQUARE_LOCATION_ID=test
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=test
PAYPAL_CLIENT_SECRET=test
PAYPAL_WEBHOOK_ID=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASS=postgres
DATABASE_NAME=postgres
DJANGO_DATABASE_POOL=False
DJANGO_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
IDEMPOTENCY_KEY_LOCK_LOCATION=redis://127.0.0.1:6379
STATIC_ROOT=/tmp/apis-test-static
MAINTENANCE_MODE_STATE_FILE_PATH=/tmp/apis-test-maintenance.txt
GOTENBERG_HOST=http://127.0.0.1:3000
