# Non-secret configuration consumed by kustomize's configMapGenerator
# and materialised into the `apis-config` ConfigMap. Anything in this
# file is readable to anyone with `get configmap` in the namespace, so
# it MUST contain no credentials. Secret material is delivered via
# SecretProviderClass + apis-secrets (see secretproviderclass.yaml).
#
# Overlays (overlays/{dev,prod}) override individual values via
# `configMapGenerator` with `behavior: merge` — they don't need to
# re-declare every key.

# Django
DJANGO_LOGLEVEL=info
DJANGO_DEBUG=False
TZ=America/New_York
USE_X_FORWARDED_HOST=True

# Security headers (overlay can override per env)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Trusted-proxy chain — AppGW is the upstream. TRUSTED_PROXY_CIDRS is
# overlay-supplied (it's the AppGW subnet CIDR).
TRUSTED_PROXY_MODE=proxy
CLIENT_IP_HEADER=X-Forwarded-For
REAL_IP_RECURSIVE=on
TRUSTED_CLIENT_IP_HEADER=X-Real-IP

# In-cluster Postgres
DATABASE_HOST=postgres.apis.svc.cluster.local
DATABASE_NAME=apis
DATABASE_USER=apis
DATABASE_SSLMODE=prefer

# In-cluster Redis
DJANGO_REDIS_URL=redis://redis.apis.svc.cluster.local:6379/1
CELERY_BROKER_URL=redis://redis.apis.svc.cluster.local:6379/2
CELERY_RESULT_BACKEND=redis://redis.apis.svc.cluster.local:6379/2
IDEMPOTENCY_KEY_LOCK_LOCATION=redis://redis.apis.svc.cluster.local:6379

# Email (overlay overrides per env)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_USE_TLS=True

# Payment provider env flags (creds via secret)
SQUARE_ENVIRONMENT=production
SQUARE_CURRENCY=USD
PAYPAL_ENVIRONMENT=production
PAYPAL_CURRENCY=USD

# MQTT
MQTT_BROKER_HOST=mqtt.example.com
MQTT_BROKER_PORT=8883
MQTT_BROKER_TLS=True

# Maintenance mode state — Redis-backed (read-only fs compatible)
MAINTENANCE_MODE_STATE_BACKEND=maintenance_mode.backends.CacheBackend

# Sentry + metrics
SENTRY_ENABLED=True
SENTRY_SEND_DEFAULT_PII=False
SENTRY_TRACES_SAMPLE_RATE=0.1
APIS_METRICS_BACKEND=DummyReporter

# Bootstrap admin (overlay overrides email per env)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.org

# Admin banner
ENVIRONMENT_NAME=Production
ENVIRONMENT_COLOR=#cc0000
ENVIRONMENT_TEXT_COLOR=#ffffff
ENVIRONMENT_FLOAT=True

# S34 / peer-review (single-locus migration): the dedicated apis-migrate
# Job runs `manage.py migrate` exactly once per deploy. App + worker
# pods MUST NOT also migrate (replicas:2 would race; a destructive
# RunPython across two pods is the worst case). start.sh gates migrate
# on this flag; the migrate Job invokes manage.py directly and ignores
# it. See aks/README.md deploy order.
APIS_RUN_MIGRATIONS=0
