# --------------------------------------------------------------------------
# APIS — Development environment template.
#
# Copy to `.env` and adjust. The dev compose file (`docker-compose.yaml`)
# bind-mounts your repo so source-code edits hot-reload without rebuilding
# the image. Run with:
#
#     docker compose up -d
#
# These values are dev-only: they're permissive about secrets, IPs, and
# proxy-trust so the loop is fast. For production, copy the prod template
# instead (.env.prod.example) onto your VM as .env.
# --------------------------------------------------------------------------

APIS_ADMIN_NAME=Local Admin
APIS_ADMIN_EMAIL=admin@localhost
APIS_DEFAULT_EMAIL=registration@localhost

# === Django ==============================================================
DJANGO_SECRET_KEY=dev-only-do-not-use-anywhere-real-1234567890abcdef
DJANGO_LOGLEVEL=info
# Dev runs with DEBUG=True so SECURE_SSL_REDIRECT / HSTS / secure-cookie
# behavior is off — otherwise http://localhost would be redirected to
# https and CSRF would reject the http Referer. Prod always sets False.
DJANGO_DEBUG=True
DJANGO_SERVER_EMAIL=no-reply@localhost
TZ=America/New_York

# Permissive hosts for local docker access. Dev exposes gunicorn directly
# on 8000 (no nginx sidecar). Prod has apis-nginx in front on 80/443.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Disable HSTS locally — otherwise browsers pin localhost on HTTPS forever.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# === Trusted-proxy plumbing =============================================
# Dev exposes gunicorn directly — no proxy in front. "none" makes Django
# treat the request as direct (http scheme, no X-Forwarded-Proto trust).
# In production the apis-nginx sidecar terminates TLS and sets the
# X-Forwarded-* headers; see .env.prod.example for the prod values.
TRUSTED_PROXY_MODE=none
# Empty = fall back to REMOTE_ADDR (correct for dev: no proxy in front).
TRUSTED_CLIENT_IP_HEADER=

# === Database ============================================================
DATABASE_HOST=postgres
DATABASE_NAME=apis
DATABASE_USER=apis
DATABASE_PASS=secret
DATABASE_SSLMODE=prefer

# === Cache / Celery ======================================================
DJANGO_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2
IDEMPOTENCY_KEY_LOCK_LOCATION=redis://redis:6379

# === Persistent data dir =================================================
APIS_DATA_DIR=/srv/apis

# === Square (sandbox) ====================================================
SQUARE_APPLICATION_ID=sandbox-sq0idp-test
SQUARE_ACCESS_TOKEN=test-access-token
SQUARE_LOCATION_ID=test-location
SQUARE_CURRENCY=USD
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=test-key

# === PayPal (sandbox) ====================================================
PAYPAL_CLIENT_ID=test
PAYPAL_CLIENT_SECRET=test
PAYPAL_CURRENCY=USD
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# === Email — SMTP stub (emails will fail; fine for dev) ==================
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=noreply@localhost
EMAIL_HOST_PASSWORD=test
EMAIL_USE_TLS=False

# === MQTT ================================================================
MQTT_EXTERNAL_BROKER=ws://localhost/mqtt
MQTT_JWT_SECRET=dGVzdHRlc3R0ZXN0dGVzdA==
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS=False

# === Read-only fs overrides ==============================================
# maintenance-mode state defaults to the Redis cache backend (set in
# settings.py), so this is unused unless you switch to the file backend.
MAINTENANCE_MODE_STATE_FILE_PATH=/tmp/maintenance_mode_state.txt

# === Admin banner ========================================================
ENVIRONMENT_NAME=Local Dev
ENVIRONMENT_COLOR=#FF8800
ENVIRONMENT_TEXT_COLOR=#FFFFFF
ENVIRONMENT_FLOAT=False

# === First-run admin bootstrap ===========================================
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=DevAdmin-2026-Strong!
