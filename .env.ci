# .env.ci — GitHub Actions CI posture (Decision #11). TRACKED, secret-free,
# fully independent. Loaded into $GITHUB_ENV by the django.yml "Run Tests"
# step. Real sandbox secrets (SQUARE_*/PAYPAL_*/EMAIL_*) are injected
# separately by the workflow from GitHub Actions secrets — never tracked.
APIS_ENV=ci
DJANGO_SETTINGS_MODULE=fm_eventmanager.settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=ci-test-secret
DJANGO_LOGLEVEL=info
COVERAGE_FAIL_UNDER=0
ALLOWED_HOSTS=testserver,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://testserver,http://localhost,http://127.0.0.1
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_MODE=none
WHITENOISE_ENABLED=False
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True
AXES_ENABLED=False
MQTT_JWT_SECRET=YXBpcy10ZXN0LW9ubHktbXF0dC1qd3QtaHMyNTYta2V5
WEBHOOK_MAX_AGE_SECONDS=3153600000
WEBHOOK_FUTURE_SKEW_SECONDS=300
SQUARE_ENVIRONMENT=sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASS=postgres
DATABASE_NAME=postgres
DJANGO_DATABASE_POOL=False
DJANGO_REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
IDEMPOTENCY_KEY_LOCK_LOCATION=redis://localhost:6379
STATIC_ROOT=/tmp/apis-ci-static
MAINTENANCE_MODE_STATE_FILE_PATH=/tmp/apis-ci-maintenance.txt
GOTENBERG_HOST=http://localhost:3000
