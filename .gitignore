# Vite bundler output (inside registration/static/ for AppDirectoriesFinder)
/registration/static/bundler/

# ``collectstatic`` outputs from third-party Django apps land here because
# this directory is also the registration app's own static source tree.
# The source files (css/, fonts/, img/, js/, webfonts/, top-level icons)
# stay tracked; everything else is vendored by running collectstatic and
# should NOT be committed. Add new entries here if you install a Django
# app that ships its own static files.
/registration/static/account/
/registration/static/admin/
/registration/static/debug_toolbar/
/registration/static/django_extensions/
/registration/static/import_export/
/registration/static/mfa/
azure/.azure
/media/*
